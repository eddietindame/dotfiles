{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#d3c6aa",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#859289"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#2d353b",
    "background_color": "#a7c080",
    "bold": true
  },
  "h2": {
    "prefix": " ",
    "suffix": " ",
    "color": "#2d353b",
    "background_color": "#dbbc7f",
    "bold": true
  },
  "h3": {
    "prefix": " ",
    "suffix": " ",
    "color": "#2d353b",
    "background_color": "#a7c080",
    "bold": true
  },
  "h4": {
    "color": "#83c092"
  },
  "h5": {
    "color": "#83c092"
  },
  "h6": {
    "color": "#859289"
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "#9da9a0"
  },
  "strong": {
    "bold": true,
    "color": "#e69875"
  },
  "hr": {
    "color": "#4f585e",
    "format": "\n────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#7fbbb3",
    "underline": true
  },
  "link_text": {
    "color": "#83c092",
    "bold": true
  },
  "image": {
    "color": "#7fbbb3",
    "underline": true
  },
  "image_text": {
    "color": "#859289",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#e67e80",
    "background_color": "#343f44"
  },
  "code_block": {
    "color": "#9da9a0",
    "margin": 2
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
